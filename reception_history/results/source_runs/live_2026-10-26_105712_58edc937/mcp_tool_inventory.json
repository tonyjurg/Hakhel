  {
    "name": "text_search",
    "title": "Text Search",
    "description": "Searches across the entire Jewish library for passages containing specific terms.\n\nSEARCH TIPS:\n- Hebrew/Aramaic searches are more reliable than English translations\n- English searches can be hit-and-miss due to translation variations\n- If no results found, try searching with fewer words\n- Use specific Hebrew terms when possible for better accuracy",
    "inputSchema": {
      "properties": {
        "query": {
          "type": "string",
          "description": "Search terms (Hebrew/Aramaic preferred for best results)."
        },
        "filters": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Category paths to limit search scope."
        },
        "size": {
          "default": 10,
          "type": "integer",
          "description": "Maximum number of results to return."
        }
      },
      "required": [
        "query"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "properties": {
        "result": {
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
