  {
    "name": "english_semantic_search",
    "title": null,
    "description": "Performs semantic similarity search on English embeddings of texts from Sefaria.\n\nThis tool uses semantic similarity to find text chunks that are conceptually \nrelated to your query, even if they don't contain the exact same words.  Through this \nyou can discover texts that traditional keyword search or link search might miss\n\nSEARCH TIPS:\n- This database is encoded from English.  Works well only with English queries\n- Search for phrases and sentences close to what you want to find.  Query for something close to the answer, not the question.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "description": "The search query to find semantically similar text chunks."
        },
        "filters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional metadata filters to apply to the search. Can include:\n- document_categories: List of document types (e.g., [\"Mishnah\", \"Talmud\"]). Use get_name to validate category names.\n- authors: List of author names (e.g., [\"Rashi\", \"Rambam\"]). Use get_name to validate author names.\n- eras: List of historical periods. Valid values: \"Tannaim\", \"Amoraim\", \"Geonim\", \"Rishonim\", \"Acharonim\", \"Contemporary\"\n- topics: List of topics (e.g., [\"halakhah\", \"aggadah\"]). Use get_name to validate topic names.\n- places: List of composition places (e.g., [\"Jerusalem\", \"Babylon\"])"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object",
      "x-fastmcp-wrap-result": true
    },
    "icons": null,
    "annotations": null,
    "meta": {
      "fastmcp": {
        "tags": []
      }
    },
    "execution": null
